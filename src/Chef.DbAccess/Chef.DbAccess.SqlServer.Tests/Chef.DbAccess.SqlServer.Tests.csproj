<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <!-- 暫時固定 C# 13：C# 14 在 .NET 10 會把 array.Contains(x) 綁定到 MemoryExtensions.Contains，3.x 無法翻譯。
         v5 的 Contains 翻譯要支援 C# 14，v5 的測試開始時移除這個設定。 -->
    <LangVersion>13</LangVersion>
    <IsPackable>false</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Transactions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chef.DbAccess.SqlServer\Chef.DbAccess.SqlServer.csproj" />
    <ProjectReference Include="..\Chef.DbAccess\Chef.DbAccess.csproj" />
  </ItemGroup>

</Project>
